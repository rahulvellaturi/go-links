{
  "name": "go-links",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "oxlint"
  },
  "dependencies": {
    "express": "^4.22.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/jest": "^29.5.2",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^29.6.1",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "ts-jest": "^29.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
